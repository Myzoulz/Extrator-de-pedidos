# Provedor de extração: "gemini" (grátis) ou "anthropic".
LLM_PROVIDER=gemini

# --- Google Gemini (free tier, sem cartão) ---
# Pegue a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Anthropic (paga; contas novas às vezes têm crédito de entrada) ---
# Pegue a chave em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Opcional: timeout em ms para cada chamada de extração (padrão: 20000)
EXTRACT_TIMEOUT_MS=20000
